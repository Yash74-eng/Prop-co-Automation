node_modules/
dist/
web/dist/
web/node_modules/
.env
.env.local

# Runtime job data — uploaded workbooks and generated outputs stay local.
# These contain confidential Figment owner/deal data. Never commit.
storage/
*.log

# Runtime config lists (institutions to avoid, developers, neighbourhood overrides).
# Internal competitive intelligence — the .example.json templates are committed instead.
config/*.json
!config/*.example.json

# Figment's real Word templates and any other letter/envelope documents.
# These carry actual letter wording and branding — keep them out of the repo,
# especially while it is public. The generated starter templates live in
# src/excel/templates.ts and are built on demand.
*.docx
*.doc
