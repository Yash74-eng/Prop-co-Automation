# Copy to .env and fill in. Never commit .env.

# Port for the local web app + API
PORT=5173

# Optional. Only step 4's "Claude cross-check" needs this; everything else works without
# it. Get a key from https://console.anthropic.com/settings/keys and paste it after the =
ANTHROPIC_API_KEY=

# Model used for cross-verification. Leave as-is unless told otherwise.
ANTHROPIC_MODEL=claude-opus-5

# Where uploaded and generated workbooks are stored (relative to repo root).
STORAGE_DIR=storage

# BizFile registered-address verification (step 4).
# On by default: the resolver below reads ACRA's open data, which needs no key, costs
# nothing, and is licensed for commercial use. Set to 0 to switch step 4 off entirely.
BIZFILE_ENABLED=1
# Milliseconds between lookups. data.gov.sg throttles bursts, so do not lower this much.
BIZFILE_DELAY_MS=400
# Live resolver for step 4:
#   opendata   ACRA's monthly open-data publication on data.gov.sg. Recommended: no
#              login, no reCAPTCHA, no per-lookup fee, whole queue in one run.
#   selenium   scrapes bizfile.gov.sg in a visible browser. reCAPTCHA-gated; capped at 10.
#   playwright same, via Playwright.
BIZFILE_DRIVER=opendata
# Seconds-scale timeout for ONE search before giving up on it.
BIZFILE_TIMEOUT_MS=30000
# 1 = visible browser (required: headless is CloudFront-blocked). 0 = headless.
BIZFILE_HEADFUL=1

# Reading the tracker or comps live from Google Sheets (optional).
# Path to the service-account JSON key Google downloads, or the JSON itself on one line.
# The sheet stays private: share it with the service-account address (it ends in
# .iam.gserviceaccount.com) as a Viewer. Without this, only a sheet that is already
# link-shared or published can be read.
GOOGLE_SERVICE_ACCOUNT_JSON=

# If the key is committed encrypted (secrets/google-service-account.json.enc), set the
# passphrase here instead of a file path. The passphrase never goes in the repo — send it
# through a password manager or a direct message. Create the encrypted file with:
#   npm run key:encrypt -- "the-key-google-downloaded.json"
GOOGLE_SERVICE_ACCOUNT_PASSPHRASE=
