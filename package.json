{
  "name": "propco-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Figment PropCo outreach automation — lawyer letter & postcard mail-merge sheet builder",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "test:real": "tsx test/real-data.check.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "playwright": "^1.49.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
