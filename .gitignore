node_modules/
dist/
web/dist/
web/node_modules/
.env
.env.local

# Runtime job data — uploaded workbooks and generated outputs stay local.
# These contain confidential Figment owner/deal data. Never commit.
storage/
*.log

# Runtime config lists (institutions to avoid, developers, neighbourhood overrides).
# Internal competitive intelligence — the .example.json templates are committed instead.
config/*.json
!config/*.example.json

# Figment's real Word templates and any other letter/envelope documents.
# These carry actual letter wording and branding — keep them out of the repo,
# especially while it is public. The generated starter templates live in
# src/excel/templates.ts and are built on demand.
*.docx
*.doc

# Credential files. A committed service-account key is a live credential to a sheet of
# owner names and mailing addresses, and rotating it means re-sharing the spreadsheet.
# Matched by shape rather than by one expected name: the first version of this block
# listed *service-account*.json and missed propco-sheets-key.json, which is the name the
# setup instructions actually tell you to use.
*key.json
*keys.json
*service-account*.json
*credential*.json
*-sa.json
# The filename Google itself gives a downloaded key: <project-id>-<12 hex chars>.json.
# This is the file sitting in Downloads, and no name-based guess would have caught it.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
gcp-*.json
.propco/
