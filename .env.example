# Copy to .env and fill in. Never commit .env.

# Port for the local web app + API
PORT=5173

# Required only for the "Cross-verify with Claude" step (step 9).
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used for cross-verification. Leave as-is unless told otherwise.
ANTHROPIC_MODEL=claude-opus-5

# Where uploaded and generated workbooks are stored (relative to repo root).
STORAGE_DIR=storage

# BizFile registered-address verification (step 4).
# 0 = off, 1 = allow the live browser resolver to run.
BIZFILE_ENABLED=0
# Milliseconds to wait between BizFile searches (be polite to a .gov.sg site).
BIZFILE_DELAY_MS=4000
# Live resolver for step 4:
#   opendata   ACRA's monthly open-data publication on data.gov.sg. Recommended: no
#              login, no reCAPTCHA, no per-lookup fee, whole queue in one run.
#   selenium   scrapes bizfile.gov.sg in a visible browser. reCAPTCHA-gated; capped at 10.
#   playwright same, via Playwright.
BIZFILE_DRIVER=opendata
# Seconds-scale timeout for ONE search before giving up on it.
BIZFILE_TIMEOUT_MS=30000
# 1 = visible browser (required: headless is CloudFront-blocked). 0 = headless.
BIZFILE_HEADFUL=1
